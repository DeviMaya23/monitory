# Every config key the app reads. Copy to .env (gitignored) for local development.
# Each key says: where its value comes from, and whether it is secret.
# Keys with a default are optional; the value shown is the default unless noted.

# --- Required: the app does not start without these (FR-101, FR-102) ---
# Source: choose it. Not secret.
ADMIN_USERNAME=
# Source: generate it (a password manager, or `openssl rand -base64 24`). SECRET.
ADMIN_PASSWORD=

# --- Server ---
# Source: fixed. Not secret. The address the Go server listens on.
LISTEN_ADDR=:8080
# Source: derive from where the volume is mounted (/data/monitory.db in the container). Not secret.
# Local development value shown.
DATABASE_PATH=./data/monitory.db

# --- HTTPS and proxy (FR-97 to FR-99) ---
# Source: decide per install. Not secret. true behind HTTPS; false for plain HTTP on a private network
# and for local development.
REQUIRE_HTTPS=true
# Source: decide per install. Not secret. true only when a proxy you control is in front of the app.
TRUST_PROXY=false
# Source: the proxy's documentation. Not secret. Read only when TRUST_PROXY=true.
# X-Forwarded-For (last entry) for Caddy and nginx; Fly-Client-IP on Fly.io.
CLIENT_IP_HEADER=X-Forwarded-For

# --- SMTP (FR-81, FR-85). Leave SMTP_HOST empty for "no SMTP account configured". ---
# Source: copy from the SMTP provider's dashboard. Not secret. Local development: localhost (Mailpit).
SMTP_HOST=
# Source: copy from the SMTP provider's dashboard. Not secret. Local development: 1025 (Mailpit).
SMTP_PORT=587
# Source: copy from the SMTP provider's dashboard. Not secret. One of: starttls, tls, none.
SMTP_TLS=starttls
# Source: copy from the SMTP provider's dashboard. Not secret.
SMTP_USERNAME=
# Source: copy from the SMTP provider's dashboard. SECRET.
SMTP_PASSWORD=
# Source: choose it; must be a sender the SMTP provider accepts. Not secret.
SMTP_FROM=

# --- Check settings: default, minimum and maximum (FR-57). Source: requirements. Not secret. ---
CHECK_INTERVAL_DEFAULT_SECONDS=60
CHECK_INTERVAL_MIN_SECONDS=30
CHECK_INTERVAL_MAX_SECONDS=86400
TIMEOUT_DEFAULT_SECONDS=10
TIMEOUT_MIN_SECONDS=1
TIMEOUT_MAX_SECONDS=60
RETRY_COUNT_DEFAULT=2
RETRY_COUNT_MIN=0
RETRY_COUNT_MAX=5
RETRY_INTERVAL_DEFAULT_SECONDS=10
RETRY_INTERVAL_MIN_SECONDS=1
RETRY_INTERVAL_MAX_SECONDS=300

# --- Limits. Source: requirements (the ID after each). Not secret. ---
# FR-58
MAX_REDIRECTS=3
# FR-59
SERVICE_NAME_MAX_LENGTH=100
# FR-60
MAX_SERVICES=50
# FR-19
MAX_TARGETS_PER_SERVICE=5
# FR-69
MAX_JSON_RULES=10
# FR-73, FR-104
RESPONSE_BODY_MAX_BYTES=65536
# FR-38
REQUEST_URL_MAX_LENGTH=2048
REQUEST_MAX_QUERY_PARAMS=20
REQUEST_MAX_HEADERS=20
HEADER_NAME_MAX_LENGTH=128
HEADER_VALUE_MAX_LENGTH=4096
REQUEST_BODY_MAX_BYTES=65536
API_REQUEST_MAX_BYTES=1048576
# FR-110
EMAIL_MAX_LENGTH=254
WEBHOOK_URL_MAX_LENGTH=2048
# FR-32
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# FR-85
ALERT_DELIVERY_RETRIES=3
ALERT_DELIVERY_RETRY_INTERVAL_SECONDS=30
# FR-91
WEBHOOK_TIMEOUT_SECONDS=10
